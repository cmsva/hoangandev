# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_NAME=HoangAnDev

# ─── MongoDB (Atlas / Production Connection URI) ──────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hoangandev?retryWrites=true&w=majority

# ─── Auth (JWT - Tối thiểu 32 ký tự ngẫu nhiên) ───────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string-in-production-env

JWT_EXPIRES_IN=7d

# ─── Encryption (AES-256-GCM, 32 bytes hex) ──────────────────────────────────
# Tạo bằng lệnh: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Cron Engine (true/false) ────────────────────────────────────────────────
CRON_ENGINE=true

# ─── Optional secrets ────────────────────────────────────────────────────────
# CRON_SECRET=                  # Có thể đặt qua DB ở Admin → Bảo mật
# REDIS_URL=redis://...         # Tùy chọn cho Rate Limiting & Cache (Upstash Redis)
